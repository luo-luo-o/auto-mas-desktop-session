+def maximize_window(hwnd: int) -> bool:
+    win32gui.ShowWindow(hwnd, win32con.SW_MAXIMIZE)
+    return win32gui.GetWindowPlacement(hwnd)[1] == win32con.SW_SHOWMAXIMIZED
